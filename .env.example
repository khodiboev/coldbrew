# Serverni ishga tushirish uchun zarur bo'lgan environment variable lar.
# Bu faylni nusxalab ".env" nomi bilan saqlang va haqiqiy qiymatlarni kiriting.
# ".env" fayli hech qachon git'ga qo'shilmasligi kerak (.gitignore da allaqachon bor).

PORT=3003

# MongoDB Atlas connection string (Database Access > Connect > Drivers)
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority

# Kamida 32 ta tasodifiy belgidan iborat maxfiy qiymatlar (masalan: openssl rand -hex 32)
SESSION_SECRET=replace_with_a_random_32plus_character_secret
SECRET_TOKEN=replace_with_a_random_32plus_character_secret

# Production serverda "production" qilib qo'ying (bu cookie secure/sameSite va CORS qat'iyligini yoqadi)
NODE_ENV=production

# Production'da frontend qaysi domendan so'rov yuborishiga ruxsat berilishini vergul bilan ajratib yozing.
# Masalan: https://coldbrew.vercel.app,https://www.coldbrew.com
ALLOWED_ORIGINS=

# HTTPS bo'lsa true
COOKIE_SECURE=false
