<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/home.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.globe.min.js"></script>

<body>
  <div id="vanta-bg" class="home-container">

    <div class="hero-content">
      <div class="hero-label">☕ Admin Panel</div>
      <% if(member) { %>
        <div class="hero-title">Welcome back,<br /><%= member.memberNick %></div>
        <div class="hero-subtitle">Manage your café from one place</div>
        <div class="hero-stats">
          <div class="hero-stat">
            <div class="hero-stat-num"><%= productCount %>+</div>
            <div class="hero-stat-label">Products</div>
          </div>
          <div class="hero-stat">
            <div class="hero-stat-num">24/7</div>
            <div class="hero-stat-label">Uptime</div>
          </div>
          <div class="hero-stat">
            <div class="hero-stat-num">∞</div>
            <div class="hero-stat-label">Coffee</div>
          </div>
        </div>
        <div class="hero-btns">
          <a href="/admin/product/all" class="hero-btn-primary">Menu →</a>
          <a href="/admin/user/all" class="hero-btn-secondary">Users</a>
          <a href="/admin/content" class="hero-btn-secondary">Content</a>
          <a href="/admin/logout" class="hero-btn-secondary" onclick="return confirm('Logout?')">Logout</a>
        </div>
      <% } else { %>
        <div class="hero-title">ColdBrew<br />Admin</div>
        <div class="hero-subtitle">Death Before Decaf</div>
        <div class="hero-btns">
          <a href="/admin/login" class="hero-btn-primary">Login →</a>
          <a href="/admin/signup" class="hero-btn-secondary">Signup</a>
        </div>
      <% } %>
    </div>

  </div>

  <script>
    VANTA.GLOBE({
      el: "#vanta-bg",
      mouseControls: true,
      touchControls: true,
      gyroControls: false,
      minHeight: 200.00,
      minWidth: 200.00,
      color: 0xe8c97a,
      color2: 0xc8976e,
      backgroundColor: 0x0a0806,
      size: 1.2,
    });
  </script>
</body>

<%- include('includes/footer') %>